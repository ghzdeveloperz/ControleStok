# Configuração pública do Firebase Web. Variáveis VITE_* são incluídas no bundle.
VITE_FIREBASE_API_KEY=replace-with-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=replace-with-firebase-auth-domain
VITE_FIREBASE_PROJECT_ID=replace-with-firebase-project-id
VITE_FIREBASE_STORAGE_BUCKET=replace-with-firebase-storage-bucket
VITE_FIREBASE_MESSAGING_SENDER_ID=replace-with-messaging-sender-id
VITE_FIREBASE_APP_ID=replace-with-firebase-web-app-id

# Opcional: deixe vazio quando o projeto não usar Firebase Analytics.
VITE_FIREBASE_MEASUREMENT_ID=

# Chave pública score-based do reCAPTCHA Enterprise vinculada ao App Check.
VITE_FIREBASE_APP_CHECK_SITE_KEY=replace-with-recaptcha-enterprise-site-key

# Nunca coloque um token de debug neste arquivo ou em qualquer VITE_*.
VITE_FIREBASE_APP_CHECK_DEBUG=false

# Em DEV, false mantém Auth, Firestore e Functions nos emuladores locais.
VITE_ALLOW_PRODUCTION_FIREBASE=false
